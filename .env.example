PORT=3000

# Log level: debug | info | warn | error (terminal verbosity)
LOG_LEVEL=info
LLM_BASE_URL=http://exapmle.com/v1
LLM_API_KEY=YOUR_API_KEY
LLM_MODEL=MODEL_NAME

# ── x402 Payment Gate (Hedera via Blocky402 facilitator) ────────────────────
# Hedera account that receives payments (resource server wallet)
HEDERA_SERVICE_ACCOUNT_ID=0.0.YYYYY
# Payer agent wallet the UI pays through (must hold testnet HBAR)
HEDERA_AGENT_ACCOUNT_ID=0.0.XXXXX
HEDERA_AGENT_PRIVATE_KEY=0x...
# x402 network identifier: hedera:testnet (default) | hedera:mainnet
X402_NETWORK=hedera:testnet
# Optional facilitator override; auto-derived from X402_NETWORK if omitted
# X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# Price for POST /api/proposals in tinybars (100000 = 0.001 HBAR)
PROPOSAL_PRICE_TINYBAR=100000
# Smart-report per-token pricing: price = base + per1kTokens * ceil(maxTokens/1000)
SMART_REPORT_BASE_TINYBAR=20000
SMART_REPORT_PER_1K_TOKENS_TINYBAR=10000
SMART_REPORT_MAX_TOKENS=2048

# ── ATS execution sidecar (factored-hedera) ──────────────────────────────────
# Base URL of the `hedera/` sidecar that owns all blockchain calls.
# Run the sidecar with PORT=3001 so it does not clash with this app's port 3000.
HEDERA_SERVICE_URL=http://localhost:3001
